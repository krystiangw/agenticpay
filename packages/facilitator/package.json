{
  "name": "@agenticpay/facilitator",
  "version": "0.0.1",
  "description": "Self-hosted x402 facilitator: verify + settle USDC payments on Solana",
  "license": "MIT",
  "homepage": "https://github.com/agenticpay-dev/agenticpay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticpay-dev/agenticpay.git",
    "directory": "packages/facilitator"
  },
  "keywords": [
    "x402",
    "facilitator",
    "solana",
    "usdc",
    "ai-agents",
    "payments",
    "express",
    "agentic-payments"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file=../../.env src/index.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "fund": "tsx --env-file=../../.env src/fund.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "pretest": "pnpm build"
  },
  "dependencies": {
    "@agenticpay/sdk": "workspace:*",
    "@solana/kit": "^8.4.0",
    "@solana/web3.js": "^1.99.0",
    "@x402/core": "^2.26.0",
    "@x402/extensions": "^2.26.0",
    "@x402/svm": "^2.26.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "posthog-node": "^5.52.4"
  },
  "devDependencies": {
    "@solana-program/compute-budget": "^0.19.0",
    "@solana-program/token": "^0.17.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1"
  }
}
